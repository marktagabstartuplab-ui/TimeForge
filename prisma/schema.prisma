// TimeForge — Prisma schema.
// Phase 6: Core Organization (Department, Team, Client, Project, WorkCategory, Holiday).
// Phase 7: Time Tracking (TimeEntry).
// Phase 8: Smart Timesheets (Timesheet).
// Phase 9: Daily Scrum, Supervisor Approval, KPI, Payroll Preparation.
// Every business table carries the standard columns: tenant_id, organization_id,
// created_by, updated_by, created_at, updated_at, deleted_at, version.
// RLS is applied via prisma/sql/rls.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
  REJECTED
}

enum EmploymentType {
  EMPLOYEE
  INTERN
  CONTRACTOR
  PART_TIME
  FULL_TIME
}

enum ScrumTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

// ─── Daily Scrum tasks/blockers & Session Tracking enums ────────────────────

/// Per-task status on a ScrumTask (distinct from ScrumEntry's day-level ScrumTaskStatus above).
enum ScrumTaskItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ScrumTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ScrumEditRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum BlockerSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum SessionEventType {
  CLOCK_IN
  BREAK_START
  BREAK_END
  TASK_COMPLETED
  CLOCK_OUT
}

enum AttachmentType {
  GITHUB
  FIGMA
  PR
  GOOGLE_DOCS
  OTHER_LINK
  FILE
}

enum AuditAction {
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  REVISION_REQUEST
  PAYROLL_EXPORT
  ROLE_CHANGE
  PASSWORD_CHANGE
  AI_USAGE
  SETTINGS_CHANGE
  ADMIN_ACTION
  PAYROLL_VALIDATED
  PAYROLL_APPROVED
  PAYROLL_REJECTED
  PAYROLL_SENT_TO_BANK
  /// Supervisor overrode another user's time record during review — deliberately
  /// distinct from the ADMIN_ACTION rows an employee's own edits write.
  TIME_ADJUSTMENT
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TimeEntrySource {
  TIMER
  MANUAL
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
  PAYROLL_READY
}

// Phase 9 enums ───────────────────────────────────────────────────────────────

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_REVISION
}

enum KpiMetricType {
  COUNT
  HOURS
  PERCENT
  CURRENCY
  /// Free-form metric — Name/Unit/Formula/etc. live on KpiTemplate's custom-metric fields.
  CUSTOM
}

enum KpiPeriod {
  DAILY
  WEEKLY
  MONTHLY
  PAYROLL_PERIOD
}

enum PayrollPeriodType {
  FIRST_HALF
  SECOND_HALF
  CUSTOM
}

enum PayrollPeriodStatus {
  OPEN
  GENERATED
  LOCKED
  EXPORTED
}

enum PayrollProcessingStatus {
  DRAFT
  VALIDATING
  VALIDATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT_TO_BANK
}

// ─── Tenancy & Core Organization ────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organizations Organization[]

  @@map("tenants")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  slug      String
  timezone  String    @default("UTC")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  settings        OrganizationSetting[]
  users           User[]
  departments     Department[]
  teams           Team[]
  clients         Client[]
  projects        Project[]
  workCategories  WorkCategory[]
  holidays        Holiday[]
  timeEntries     TimeEntry[]
  timesheets      Timesheet[]
  scrumEntries    ScrumEntry[]
  kpiTemplates    KpiTemplate[]
  payrollPeriods  PayrollPeriod[]
  shifts          Shift[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  recurringIssues RecurringIssue[]
  bugs            Bug[]
  shiftConfigurations   ShiftConfiguration[]
  shiftLimitViolations  ShiftLimitViolation[]
  payrollSettings       PayrollSettings?

  @@unique([tenantId, id])
  // Uniqueness on (tenantId, slug) is enforced by a partial unique index
  // (WHERE deleted_at IS NULL) added in migration 20260710000000_soft_delete_partial_unique_indexes —
  // Prisma's schema DSL can't express a partial @@unique, so this is a plain
  // index for query support only; the DB constraint is the source of truth.
  @@index([tenantId, slug])
  @@index([tenantId])
  @@map("organizations")
}

model OrganizationSetting {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  key            String
  value          Json
  type           String    @default("json")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, key])
  @@map("organization_settings")
}

// ─── Users & RBAC ────────────────────────────────────────────────────────────

model User {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  email           String
  passwordHash    String?        @map("password_hash")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  phone           String?        @map("phone")
  jobTitle        String?        @map("job_title")
  status          UserStatus     @default(PENDING)
  isApproved      Boolean        @default(false) @map("is_approved")
  // Role the user asked for at self-registration (EMPLOYEE | INTERN). It's a
  // request only — the admin assigns the real Role/UserRole on approval. Stored
  // for the approval UI + admin notification; not a security boundary.
  requestedRole   String?        @map("requested_role")
  employmentType  EmploymentType @default(EMPLOYEE) @map("employment_type")
  hourlyRate      Decimal?       @map("hourly_rate") @db.Decimal(12, 2)
  payrollEligible Boolean        @default(true) @map("payroll_eligible")
  avatarKey       String?        @map("avatar_key")
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz
  rejectedAt      DateTime?      @map("rejected_at") @db.Timestamptz
  rejectionReason String?        @map("rejection_reason")
  supervisorId    String?        @map("supervisor_id") @db.Uuid
  departmentId    String?        @map("department_id") @db.Uuid
  teamId          String?        @map("team_id") @db.Uuid
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz
  version         Int            @default(0)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until") @db.Timestamptz

  emailVerificationToken     String?   @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.Timestamptz
  passwordResetToken         String?   @map("password_reset_token")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz

  organization          Organization      @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  department            Department?       @relation(fields: [departmentId], references: [id])
  team                  Team?             @relation(fields: [teamId], references: [id])
  supervisor            User?             @relation("UserSupervisor", fields: [supervisorId], references: [id])
  subordinates          User[]            @relation("UserSupervisor")
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  timeEntries           TimeEntry[]
  timesheets            Timesheet[]
  scrumEntries          ScrumEntry[]
  scrumTasks            ScrumTask[]
  scrumEditRequests     ScrumEditRequest[] @relation("ScrumEditRequester")
  scrumEditResolutions  ScrumEditRequest[] @relation("ScrumEditResolver")
  workSessions          WorkSession[]
  kpiProgress           KpiProgress[]
  approvals             Approval[]        @relation("SupervisorApprovals")
  payrollLineItems      PayrollLineItem[]
  notifications         Notification[]
  sentNotifications     Notification[]    @relation("NotificationSender")
  departmentsManaged    Department[]      @relation("DepartmentManager")
  securityLogs          SecurityLog[]
  securityAlerts        SecurityAlert[]
  generatedReports      GeneratedReport[]
  shifts                Shift[]
  leaveRequests         LeaveRequest[]    @relation("LeaveRequestUser")
  leaveRequestsReviewed LeaveRequest[]    @relation("LeaveRequestReviewer")
  leaveBalances         LeaveBalance[]    @relation("LeaveBalanceUser")
  bugsReported          Bug[]             @relation("BugReporter")
  bugsAssigned          Bug[]             @relation("BugAssignee")
  bugComments           BugComment[]
  bugActivity           BugActivityLog[]
  bugAttachments        BugAttachment[]
  shiftViolations       ShiftLimitViolation[] @relation("ShiftViolationEmployee")
  shiftViolationsActed  ShiftLimitViolation[] @relation("ShiftViolationSupervisor")
  shiftOverridesGranted WorkSession[]         @relation("WorkSessionOverrideSupervisor")

  @@unique([tenantId, id])
  // Uniqueness on (tenantId, email) is enforced by a partial unique index
  // (WHERE deleted_at IS NULL) — see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, email])
  @@index([tenantId, organizationId])
  @@index([tenantId, teamId])
  @@index([tenantId, organizationId, supervisorId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, organizationId, departmentId])
  @@map("users")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean   @default(true) @map("is_system")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  permissions RolePermission[]
  users       UserRole[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, key])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Auth sessions ───────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  device    String?
  ip        String?
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, expiresAt])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Audit & idempotency ─────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType, action, createdAt(sort: Desc)])
  @@map("audit_log")
}

model IdempotencyKey {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  endpoint  String?
  resultRef String?   @map("result_ref")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, key])
  @@map("idempotency_keys")
}

// ─── Core Organization — Phase 6 ─────────────────────────────────────────────

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  isActive       Boolean   @default(true) @map("is_active")
  managerId      String?   @map("manager_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization    Organization     @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  manager         User?            @relation("DepartmentManager", fields: [managerId], references: [id])
  users           User[]
  teams           Team[]
  projects        Project[]
  shifts          Shift[]
  timeEntries     TimeEntry[]
  recurringIssues RecurringIssue[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, name])
  @@map("departments")
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  departmentId   String?   @map("department_id") @db.Uuid
  supervisorId   String?   @map("supervisor_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  users        User[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, name])
  @@map("teams")
}

model Client {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  contact        String?
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  projects     Project[]
  timeEntries  TimeEntry[]
  scrumEntries ScrumEntry[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, name])
  @@map("clients")
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  DELAYED
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  code           String
  clientId       String?       @map("client_id") @db.Uuid
  departmentId   String?       @map("department_id") @db.Uuid
  status         ProjectStatus @default(ON_TRACK)
  billable       Boolean       @default(true)
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  version        Int           @default(0)

  organization    Organization     @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  client          Client?          @relation(fields: [clientId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  timeEntries     TimeEntry[]
  scrumEntries    ScrumEntry[]
  scrumTasks      ScrumTask[]
  recurringIssues RecurringIssue[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, code])
  @@index([tenantId, organizationId, departmentId])
  @@map("projects")
}

model WorkCategory {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  timeEntries  TimeEntry[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, name])
  @@map("work_categories")
}

 /// Philippine holiday classification — drives the premium multiplier applied to
 /// hours worked on the day (Labor Code art. 94 / DOLE Handbook):
 /// REGULAR             — 200% when worked, 100% when not worked
 /// SPECIAL_NON_WORKING — 130% when worked, no-work-no-pay when not worked
enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING

  @@map("holiday_type")
}

model Holiday {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  date           DateTime    @db.Date
  type           HolidayType @default(REGULAR)
  recurring      Boolean     @default(false)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        Int       @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes.
  @@index([tenantId, organizationId, date, name])
  @@map("holidays")
}

// ─── Time Tracking — Phase 7 ─────────────────────────────────────────────────

model TimeEntry {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  timesheetId     String?         @map("timesheet_id") @db.Uuid
  workSessionId   String?         @map("work_session_id") @db.Uuid
  projectId       String?         @map("project_id") @db.Uuid
  clientId        String?         @map("client_id") @db.Uuid
  workCategoryId  String?         @map("work_category_id") @db.Uuid
  source          TimeEntrySource @default(MANUAL)
  startTime       DateTime        @map("start_time") @db.Timestamptz
  endTime         DateTime?       @map("end_time") @db.Timestamptz
  durationMinutes Int?            @map("duration_minutes")
  task            String?
  description     String?
  deliverables    String?
  departmentId    String?         @map("department_id") @db.Uuid
  referenceLinks  Json?           @map("reference_links")
  attachments     Json?           @map("attachments")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz
  version         Int             @default(0)

  organization Organization  @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  user         User          @relation(fields: [userId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  workCategory WorkCategory? @relation(fields: [workCategoryId], references: [id])
  timesheet    Timesheet?    @relation(fields: [timesheetId], references: [id])
  workSession  WorkSession?  @relation(fields: [workSessionId], references: [id])

  @@index([tenantId, userId, startTime])
  @@index([tenantId, organizationId])
  @@index([tenantId, departmentId])
  @@index([tenantId, projectId])
  @@index([tenantId, clientId])
  @@index([timesheetId])
  @@index([workSessionId])
  @@map("time_entries")
}

// ─── Smart Timesheets — Phase 8 ──────────────────────────────────────────────

model Timesheet {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  status         TimesheetStatus @default(DRAFT)
  periodStart    DateTime        @map("period_start") @db.Date
  periodEnd      DateTime        @map("period_end") @db.Date
  totalMinutes   Int             @default(0) @map("total_minutes")
  /// Supervisor-set overtime for this period. NULL = derive it from the entries
  /// (>8h/day), which is how every un-adjusted timesheet behaves.
  overtimeMinutesOverride Int?    @map("overtime_minutes_override")
  summary        String?
  submittedAt    DateTime?       @map("submitted_at") @db.Timestamptz
  decidedAt      DateTime?       @map("decided_at") @db.Timestamptz
  createdBy      String?         @map("created_by") @db.Uuid
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  version        Int             @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  user         User         @relation(fields: [userId], references: [id])
  entries      TimeEntry[]
  approvals    Approval[]

  @@index([tenantId, userId, periodStart])
  @@index([tenantId, status, organizationId])
  @@index([tenantId, organizationId, status, periodStart])
  @@map("timesheets")
}

// ─── Daily Scrum — Phase 9 ───────────────────────────────────────────────────

model ScrumEntry {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  entryDate      DateTime        @map("entry_date") @db.Date
  yesterday      String
  /// Legacy JSON-encoded task list; superseded by the ScrumTask table. Kept for backward compatibility.
  today          String
  /// Legacy JSON-encoded blocker list; superseded by the ScrumBlocker table. Kept for backward compatibility.
  blockers       String?
  notes          String?
  /// Self-reported task progress for the day, 0–100.
  progress       Int             @default(0)
  status         ScrumTaskStatus @default(NOT_STARTED)
  /// True once progress reaches 100% — mirrors status === COMPLETED but persisted explicitly per spec.
  isLocked       Boolean         @default(false) @map("is_locked")
  submittedAt    DateTime?       @map("submitted_at") @db.Timestamptz
  projectId      String?         @map("project_id") @db.Uuid
  clientId       String?         @map("client_id") @db.Uuid
  kpi            String?
  plannedTarget  String?         @map("planned_target")
  supervisorNote String?         @map("supervisor_note")
  createdBy      String?         @map("created_by") @db.Uuid
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  version        Int             @default(0)

  organization Organization   @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  user         User           @relation(fields: [userId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  client       Client?        @relation(fields: [clientId], references: [id])
  tasks        ScrumTask[]
  blockerItems ScrumBlocker[]
  editRequests ScrumEditRequest[]

  // Uniqueness enforced by a partial unique index (WHERE deleted_at IS NULL) —
  // see migration 20260710000000_soft_delete_partial_unique_indexes. The plain
  // index below (same columns) already covers query support.
  @@index([tenantId, organizationId, entryDate])
  @@index([tenantId, userId, entryDate])
  @@index([tenantId, organizationId, submittedAt])
  @@map("scrum_entries")
}

// ─── Daily Scrum Tasks & Blockers ────────────────────────────────────────────

model ScrumTask {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  scrumEntryId   String              @map("scrum_entry_id") @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  title          String
  description    String?
  expectedOutput String              @map("expected_output")
  measurement    String
  projectId      String?             @map("project_id") @db.Uuid
  taskStatus     ScrumTaskItemStatus @default(PENDING) @map("task_status")
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz
  estimatedHours Decimal?            @map("estimated_hours") @db.Decimal(6, 2)
  actualHours    Decimal?            @map("actual_hours") @db.Decimal(6, 2)
  priority       ScrumTaskPriority   @default(MEDIUM)
  // kpi display text is resolved from the template name when kpiTemplateId is
  // set; plannedTarget is the employee's editable daily commitment, pre-filled
  // from the template's targetValue as a suggestion but changeable.
  // actualCompleted is the employee's EOD self-reported actual value.
  // continueTomorrow / notCompletedReason are captured in the EOD review only
  // when actualCompleted falls short of plannedTarget.
  kpi            String?
  plannedTarget   String?             @map("planned_target")
  actualCompleted String?             @map("actual_completed")
  continueTomorrow   Boolean?         @map("continue_tomorrow")
  notCompletedReason String?          @map("not_completed_reason")
  kpiTemplateId   String?             @map("kpi_template_id") @db.Uuid
  createdBy      String?             @map("created_by") @db.Uuid
  updatedBy      String?             @map("updated_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz
  version        Int                 @default(0)

  scrumEntry  ScrumEntry          @relation(fields: [scrumEntryId], references: [id])
  employee    User                @relation(fields: [employeeId], references: [id])
  project     Project?            @relation(fields: [projectId], references: [id])
  kpiTemplate KpiTemplate?        @relation(fields: [kpiTemplateId], references: [id])
  attachments SessionAttachment[]

  @@index([tenantId, scrumEntryId])
  @@index([tenantId, employeeId])
  @@map("scrum_tasks")
}

/// An employee's request to reopen their own locked Daily Scrum. The supervisor
/// grants it through the existing unlock endpoint (which resolves the request);
/// declining closes it with a reason. Purely a request record — the authority to
/// edit still comes from ScrumEntry.isLocked.
model ScrumEditRequest {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  scrumEntryId   String                 @map("scrum_entry_id") @db.Uuid
  /// The employee who owns the entry and asked for it back.
  requesterId    String                 @map("requester_id") @db.Uuid
  reason         String
  status         ScrumEditRequestStatus @default(PENDING)
  /// Supervisor who approved (via unlock) or declined.
  resolvedById   String?                @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz
  /// Supervisor's note when declining.
  resolutionNote String?                @map("resolution_note")
  createdBy      String?                @map("created_by") @db.Uuid
  updatedBy      String?                @map("updated_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz
  version        Int                    @default(0)

  scrumEntry ScrumEntry @relation(fields: [scrumEntryId], references: [id])
  requester  User       @relation("ScrumEditRequester", fields: [requesterId], references: [id])
  resolvedBy User?      @relation("ScrumEditResolver", fields: [resolvedById], references: [id])

  @@index([tenantId, scrumEntryId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, requesterId])
  @@map("scrum_edit_requests")
}

model ScrumBlocker {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  scrumEntryId   String          @map("scrum_entry_id") @db.Uuid
  title          String
  description    String?
  severity       BlockerSeverity @default(MEDIUM)
  status         BlockerStatus   @default(OPEN)
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz
  createdBy      String?         @map("created_by") @db.Uuid
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  version        Int             @default(0)

  scrumEntry ScrumEntry @relation(fields: [scrumEntryId], references: [id])

  @@index([tenantId, scrumEntryId])
  @@index([tenantId, organizationId, status])
  @@map("scrum_blockers")
}

// ─── Recurring Operational Issues (cross-employee/department/project) ──────
// Deterministic, rule-based detection over ScrumBlocker/ScrumTask records —
// runs alongside (not instead of) the AI BLOCKER_DETECTION toggle and the
// simple per-employee attachRecurringBlockerFlag() in scrum.service.ts.

enum RecurringIssueCategory {
  BLOCKER
  DELAY

  @@map("recurring_issue_category")
}

enum RecurringIssueTrend {
  INCREASING
  STABLE
  DECREASING

  @@map("recurring_issue_trend")
}

enum RecurringIssueStatus {
  OPEN
  RESOLVED

  @@map("recurring_issue_status")
}

model RecurringIssue {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  category        RecurringIssueCategory
  issueText       String                 @map("issue_text")
  departmentId    String?                @map("department_id") @db.Uuid
  projectId       String?                @map("project_id") @db.Uuid
  /// Employees who reported/were affected by this recurring issue.
  employeeIds     String[]               @map("employee_ids") @db.Uuid
  occurrenceCount Int                    @default(1) @map("occurrence_count")
  firstOccurrence DateTime               @map("first_occurrence") @db.Timestamptz
  lastOccurrence  DateTime               @map("last_occurrence") @db.Timestamptz
  trend           RecurringIssueTrend    @default(STABLE)
  suggestedAction String?                @map("suggested_action")
  status          RecurringIssueStatus   @default(OPEN)
  resolvedAt      DateTime?              @map("resolved_at") @db.Timestamptz
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  version         Int                    @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([tenantId, organizationId, status])
  @@index([tenantId, organizationId, departmentId])
  @@index([tenantId, organizationId, projectId])
  @@index([tenantId, organizationId, lastOccurrence])
  @@map("recurring_issues")
}

// ─── Session Tracking (WorkSession / SessionEvent / SessionAttachment) ──────

model WorkSession {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  workDate               DateTime  @map("work_date") @db.Date
  clockIn                DateTime  @map("clock_in") @db.Timestamptz
  clockOut               DateTime? @map("clock_out") @db.Timestamptz
  isActive               Boolean   @default(true) @map("is_active")
  currentBreakStartedAt  DateTime? @map("current_break_started_at") @db.Timestamptz
  breakCount             Int       @default(0) @map("break_count")
  breakMinutes           Int       @default(0) @map("break_minutes")
  sessionDurationMinutes Int?      @map("session_duration_minutes")

  // ── Shift limits (FEAT-2) ────────────────────────────────────────────────
  /// Config snapshotted at clock-in. Null on sessions that predate the feature
  /// or on orgs with no configuration — those are never limit-enforced.
  shiftConfigurationId String?   @map("shift_configuration_id") @db.Uuid
  /// Hard deadline: clockIn + maxShiftMinutes (+ grace). Extended in place when a
  /// supervisor approves an override, so it is always the single source of truth
  /// for "when does this session get force-closed".
  maxClockOutAt        DateTime? @map("max_clock_out_at") @db.Timestamptz
  isAutoClockedOut     Boolean   @default(false) @map("is_auto_clocked_out")
  autoClockOutReason   String?   @map("auto_clock_out_reason")
  /// Set when the session has crossed its limit and the org requires supervisor
  /// sign-off, so the UI can surface the blocked state after the fact.
  requiresOverride     Boolean   @default(false) @map("requires_override")
  supervisorOverrideId String?   @map("supervisor_override_id") @db.Uuid
  overrideApproved     Boolean?  @map("override_approved")
  overrideApprovedAt   DateTime? @map("override_approved_at") @db.Timestamptz

  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  version                Int       @default(0)

  user               User                @relation(fields: [userId], references: [id])
  supervisorOverride User?               @relation("WorkSessionOverrideSupervisor", fields: [supervisorOverrideId], references: [id])
  shiftConfiguration ShiftConfiguration? @relation(fields: [shiftConfigurationId], references: [id])
  timeEntries        TimeEntry[]
  events             SessionEvent[]
  attachments        SessionAttachment[]
  shiftViolations    ShiftLimitViolation[]

  @@index([tenantId, userId, workDate])
  @@index([isActive, maxClockOutAt])
  @@map("work_sessions")
}

// ─── Shift limits — FEAT-2 ───────────────────────────────────────────────────

enum ShiftViolationType {
  /// Session crossed its configured limit; not yet force-closed (grace period).
  REACHED_LIMIT
  /// Session was force-closed at the limit.
  AUTO_CLOCKED_OUT
  /// Employee asked a supervisor to extend the limit.
  MANUAL_OVERRIDE

  @@map("shift_violation_type")
}

enum ShiftSupervisorAction {
  NO_ACTION
  APPROVED
  DENIED

  @@map("shift_supervisor_action")
}

/// Per-organization maximum shift length. Durations are stored in minutes to
/// match every other duration column in this schema (durationMinutes,
/// breakMinutes, sessionDurationMinutes) and to keep arithmetic off Decimal.
model ShiftConfiguration {
  id                         String  @id @default(uuid()) @db.Uuid
  tenantId                   String  @map("tenant_id") @db.Uuid
  organizationId             String  @map("organization_id") @db.Uuid
  shiftName                  String  @default("Standard") @map("shift_name")
  maxShiftMinutes            Int     @default(720) @map("max_shift_minutes")
  /// Minutes past the limit before the session is force-closed. The warning and
  /// the REACHED_LIMIT violation fire at the limit; auto-clock-out fires at
  /// limit + grace, and the recorded clock-out time is always the limit itself.
  gracePeriodMinutes         Int     @default(0) @map("grace_period_minutes")
  requiresSupervisorOverride Boolean @default(true) @map("requires_supervisor_override")
  /// Minutes before the limit at which the employee is warned (default 60 → 11h).
  warningLeadMinutes         Int     @default(60) @map("warning_lead_minutes")
  /// Exactly one default per org is used at clock-in.
  isDefault                  Boolean @default(true) @map("is_default")

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   Int       @default(0)

  organization Organization          @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  sessions     WorkSession[]
  violations   ShiftLimitViolation[]

  @@index([tenantId, organizationId, isDefault])
  @@map("shift_configurations")
}

/// Immutable audit record of every shift-limit event. One row per event — a
/// session that warns, gets an override request, is approved, then still runs
/// out produces several rows.
model ShiftLimitViolation {
  id                       String                @id @default(uuid()) @db.Uuid
  tenantId                 String                @map("tenant_id") @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  workSessionId            String                @map("work_session_id") @db.Uuid
  employeeId               String                @map("employee_id") @db.Uuid
  shiftConfigurationId     String?               @map("shift_configuration_id") @db.Uuid
  violationType            ShiftViolationType    @map("violation_type")
  violationAt              DateTime              @default(now()) @map("violation_at") @db.Timestamptz
  minutesWorkedAtViolation Int                   @map("minutes_worked_at_violation")
  /// Only set on MANUAL_OVERRIDE rows — what the employee asked for.
  requestedExtensionMinutes Int?                 @map("requested_extension_minutes")
  supervisorAction         ShiftSupervisorAction @default(NO_ACTION) @map("supervisor_action")
  supervisorId             String?               @map("supervisor_id") @db.Uuid
  supervisorActionAt       DateTime?             @map("supervisor_action_at") @db.Timestamptz
  supervisorNote           String?               @map("supervisor_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(0)

  organization       Organization        @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  workSession        WorkSession         @relation(fields: [workSessionId], references: [id])
  employee           User                @relation("ShiftViolationEmployee", fields: [employeeId], references: [id])
  supervisor         User?               @relation("ShiftViolationSupervisor", fields: [supervisorId], references: [id])
  shiftConfiguration ShiftConfiguration? @relation(fields: [shiftConfigurationId], references: [id])

  @@index([tenantId, workSessionId])
  @@index([tenantId, employeeId, violationAt])
  @@index([tenantId, organizationId, supervisorAction])
  @@map("shift_limit_violations")
}

model SessionEvent {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  workSessionId  String           @map("work_session_id") @db.Uuid
  eventType      SessionEventType @map("event_type")
  metadata       Json?
  occurredAt     DateTime         @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  workSession WorkSession @relation(fields: [workSessionId], references: [id])

  @@index([tenantId, workSessionId, occurredAt])
  @@index([tenantId, userId, occurredAt])
  @@map("session_events")
}

model SessionAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  workSessionId  String?        @map("work_session_id") @db.Uuid
  scrumTaskId    String?        @map("scrum_task_id") @db.Uuid
  type           AttachmentType
  name           String
  url            String?
  storageKey     String?        @map("storage_key")
  uploadedBy     String         @map("uploaded_by") @db.Uuid
  uploadedAt     DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  workSession WorkSession? @relation(fields: [workSessionId], references: [id])
  scrumTask   ScrumTask?   @relation(fields: [scrumTaskId], references: [id])

  @@index([tenantId, workSessionId])
  @@index([tenantId, scrumTaskId])
  @@map("session_attachments")
}

// ─── Team Schedules ──────────────────────────────────────────────────────────

enum ShiftStatus {
  DRAFT
  PUBLISHED

  @@map("shift_status")
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  CUSTOM

  @@map("shift_type")
}

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  departmentId   String?     @map("department_id") @db.Uuid
  shiftDate      DateTime    @map("shift_date") @db.Date
  startTime      DateTime    @map("start_time") @db.Timestamptz
  endTime        DateTime    @map("end_time") @db.Timestamptz
  shiftType      ShiftType   @default(CUSTOM) @map("shift_type")
  status         ShiftStatus @default(DRAFT)
  notes          String?
  createdBy      String?     @map("created_by") @db.Uuid
  updatedBy      String?     @map("updated_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz
  version        Int         @default(0)

  organization Organization @relation(fields: [tenantId, organizationId], references: [tenantId, id])
  user         User         @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([tenantId, organizationId, shiftDate])
  @@index([tenantId, userId, shiftDate])
  @@map("shifts")
}

// ─── Supervisor Approval — Phase 9 ───────────────────────────────────────────

model Approval {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  timesheetId    String          @map("timesheet_id") @db.Uuid
  supervisorId   String          @map("supervisor_id") @db.Uuid
  lastAction     ApprovalAction  @map("last_action")
  resultingState TimesheetStatus @map("resulting_state")
  remark         String?
  actedAt        DateTime        @map("acted_at") @db.Timestamptz
  createdBy      String?         @map("created_by") @db.Uuid
  updatedBy      String?         @map("updated_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  version        Int             @default(0)

  timesheet  Timesheet @relation(fields: [timesheetId], references: [id])
  supervisor User      @relation("SupervisorApprovals", fields: [supervisorId], references: [id])

  @@index([tenantId, timesheetId])
  @@index([tenantId, supervisorId, resultingState])
  @@map("approvals")
}

// ─── Leave Management ─────────────────────────────────────────────────────

model LeaveRequest {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  type           LeaveType
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  days           Decimal            @db.Decimal(5, 2)
  reason         String
  status         LeaveRequestStatus @default(PENDING)
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewNote     String?            @map("review_note")
  attachmentKey  String?            @map("attachment_key")
  createdBy      String?            @map("created_by") @db.Uuid
  updatedBy      String?            @map("updated_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
