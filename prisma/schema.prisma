model PayrollLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  payrollReportId String   @map("payroll_report_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  approvedHours   Decimal  @default(0) @map("approved_hours") @db.Decimal(8, 2)
  pendingHours    Decimal  @default(0) @map("pending_hours") @db.Decimal(8, 2)
  rejectedHours   Decimal  @default(0) @map("rejected_hours") @db.Decimal(8, 2)
  overtimeHours   Decimal  @default(0) @map("overtime_hours") @db.Decimal(8, 2)
  hourlyRate      Decimal  @map("hourly_rate") @db.Decimal(12, 2)
  estimatedPay    Decimal  @map("estimated_pay") @db.Decimal(14, 2)

  // -- FEAT-3: Philippine statutory breakdown ---------------------------------
  // Every column below is derived at generation time and snapshotted, so a later
  // settings/rate change never silently rewrites a payslip that was already
  // issued. `estimatedPay` above is retained unchanged (it is the gross figure
  // the pre-FEAT-3 dashboards read) and equals regularPay + overtimePay.

  holidayHours   Decimal @default(0) @map("holiday_hours") @db.Decimal(8, 2)
  nightDiffHours Decimal @default(0) @map("night_diff_hours") @db.Decimal(8, 2)

  regularPay        Decimal @default(0) @map("regular_pay") @db.Decimal(14, 2)
  overtimePay       Decimal @default(0) @map("overtime_pay") @db.Decimal(14, 2)
  nightDifferential Decimal @default(0) @map("night_differential") @db.Decimal(14, 2)
  holidayPay        Decimal @default(0) @map("holiday_pay") @db.Decimal(14, 2)

  sssContribution        Decimal @default(0) @map("sss_contribution") @db.Decimal(12, 2)
  philhealthContribution Decimal @default(0) @map("philhealth_contribution") @db.Decimal(12, 2)
  pagibigContribution    Decimal @default(0) @map("pagibig_contribution") @db.Decimal(12, 2)
  incomeTaxWithheld      Decimal @default(0) @map("income_tax_withheld") @db.Decimal(12, 2)

  sssEmployerShare        Decimal @default(0) @map("sss_employer_share") @db.Decimal(12, 2)
  philhealthEmployerShare Decimal @default(0) @map("philhealth_employer_share") @db.Decimal(12, 2)
  pagibigEmployerShare    Decimal @default(0) @map("pagibig_employer_share") @db.Decimal(12, 2)

  grossTotal      Decimal @default(0) @map("gross_total") @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(14, 2)
  netPay          Decimal @default(0) @map("net_pay") @db.Decimal(14, 2)

  /// Cumulative taxable income (gross less mandatory contributions) for the tax year, this period included.
  ytdTaxableIncome Decimal @default(0) @map("ytd_taxable_income") @db.Decimal(14, 2)
  /// Cumulative tax withheld for the tax year, this period included.
  ytdTaxWithheld   Decimal @default(0) @map("ytd_tax_withheld") @db.Decimal(14, 2)

  isThirteenthMonth Boolean @default(false) @map("is_thirteenth_month")

  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version         Int      @default(0)

  payrollReport PayrollReport @relation(fields: [payrollReportId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@unique([payrollReportId, userId])
  @@index([tenantId, payrollReportId])
  @@index([tenantId, organizationId])
  @@index([tenantId, userId])
  @@map("payroll_line_items")
}

